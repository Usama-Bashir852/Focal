# --- Postgres ---
POSTGRES_USER=collabstudy
POSTGRES_PASSWORD=12345
POSTGRES_DB=collabstudy

# --- Backend ---
# DATABASE_URL is built automatically from the POSTGRES_* vars above -- don't set it separately,
# that's what caused a password mismatch before.
JWT_SECRET=33a8f5beeb57d2d5a228333bb107736f6feddd60953787c765d5106655a08c42
# Plain comma-separated list, no quotes/JSON needed.
CORS_ORIGINS=http://localhost,http://localhost:5173,https://your-domain.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Frontend (baked in at build time) ---
VITE_API_URL=http://localhost:8000
